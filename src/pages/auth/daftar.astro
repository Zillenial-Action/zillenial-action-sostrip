---
import AuthField from '../../components/auth/AuthField.astro';
import AuthShell from '../../components/auth/AuthShell.astro';
import GoogleAuthButton from '../../components/auth/GoogleAuthButton.astro';
import PasswordStrengthBar from '../../components/auth/PasswordStrengthBar.astro';
import ActionButton from '../../components/ui/ActionButton.astro';

const googleEnabled = import.meta.env.PUBLIC_GOOGLE_AUTH_ENABLED !== 'false';
---

<AuthShell title="Daftar" heading="Buat ruang untuk tiketmu." intro="Satu akun untuk memantau pesanan, menerima tiket, dan kembali ke event berikutnya.">
	<form class="auth-form" id="register-form" novalidate>
		<AuthField id="register-name" name="name" label="Nama lengkap" autocomplete="name" icon="user" placeholder="Nama lengkap kamu" required />
		<AuthField id="register-email" name="email" label="Email" type="email" autocomplete="email" inputmode="email" icon="email" placeholder="email@kamu.com" required />
		<div>
			<AuthField id="register-password" name="password" label="Password" hint="(15 sampai 72 karakter)" type="password" autocomplete="new-password" icon="lock" placeholder="Minimal 15 karakter" minlength={15} maxlength={72} required />
			<PasswordStrengthBar id="register-password" />
		</div>
		<AuthField id="register-password-confirmation" name="password_confirmation" label="Ulangi password" type="password" autocomplete="new-password" icon="lock" placeholder="Ulangi password di atas" minlength={15} maxlength={72} required />
		<ActionButton label="Buat akun" loadingLabel="Membuat akun..." icon="register" type="submit" />
		<div class="auth-divider">atau</div>
		{googleEnabled && <GoogleAuthButton label="Daftar dengan Google" />}
		<p class="auth-muted auth-center">Sudah punya akun? <a class="auth-link" href="/auth/login">Masuk</a></p>
	</form>
</AuthShell>

<script>
	import { ApiError, api } from '../../lib/api';
	import { clearFieldErrors, focusFirstInvalid, isValidEmail, setButtonLoading, setFieldError, validateStrongPassword, type AuthFieldErrors } from '../../lib/auth-form';

	const form = document.querySelector<HTMLFormElement>('#register-form');
	const submit = form?.querySelector<HTMLButtonElement>('[data-async-button]') ?? null;

	const validate = (data: FormData): AuthFieldErrors => {
		const errors: AuthFieldErrors = {};
		const name = String(data.get('name') ?? '').trim();
		const email = String(data.get('email') ?? '').trim();
		const password = String(data.get('password') ?? '');
		const confirmation = String(data.get('password_confirmation') ?? '');
		if (name.length < 2) errors.name = 'Nama lengkap minimal 2 karakter.';
		if (!email) errors.email = 'Masukkan email kamu.';
		else if (!isValidEmail(email)) errors.email = 'Gunakan format email yang valid.';
		const passwordError = validateStrongPassword(password);
		if (passwordError) errors.password = passwordError;
		if (confirmation !== password) errors.password_confirmation = 'Ulangi password harus sama.';
		return errors;
	};

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		clearFieldErrors(form);
		setButtonLoading(submit, true);
		const data = new FormData(form);
		const clientErrors = validate(data);
		if (Object.keys(clientErrors).length) {
			Object.entries(clientErrors).forEach(([field, message]) => setFieldError(form, field, message));
			window.toast.error('Periksa kembali data yang ditandai.');
			focusFirstInvalid(form);
			setButtonLoading(submit, false);
			return;
		}

		try {
			await api.auth.register({
				name: String(data.get('name') ?? '').trim(),
				email: String(data.get('email') ?? '').trim(),
				password: String(data.get('password') ?? ''),
				password_confirmation: String(data.get('password_confirmation') ?? ''),
			});
			window.location.assign('/dashboard/akun');
		} catch (error) {
			if (error instanceof ApiError && error.errors) {
				Object.entries(error.errors).forEach(([field, messages]) => setFieldError(form, field, messages[0] ?? ''));
			}
			window.toast.error(error instanceof ApiError ? error.message : 'Pendaftaran belum berhasil. Coba lagi.');
			setButtonLoading(submit, false);
		}
	});
</script>
