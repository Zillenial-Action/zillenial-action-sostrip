---
import AuthField from '../../components/auth/AuthField.astro';
import AuthShell from '../../components/auth/AuthShell.astro';
import ActionButton from '../../components/ui/ActionButton.astro';
---

<AuthShell title="Lupa password" heading="Kita bantu masuk lagi." intro="Masukkan email akunmu. Kalau terdaftar, kami kirim tautan untuk membuat password baru.">
	<form class="auth-form" id="forgot-form" novalidate>
		<AuthField id="forgot-email" name="email" label="Email" type="email" autocomplete="email" inputmode="email" icon="email" placeholder="email@kamu.com" required />
		<ActionButton label="Kirim tautan reset" loadingLabel="Mengirim tautan..." icon="send" type="submit" />
		<p class="auth-muted auth-center"><a class="auth-link" href="/auth/login">Kembali ke login</a></p>
	</form>
</AuthShell>

<script>
	import { ApiError, api } from '../../lib/api';
	import { clearFieldErrors, focusFirstInvalid, isValidEmail, setButtonLoading, setFieldError } from '../../lib/auth-form';

	const form = document.querySelector<HTMLFormElement>('#forgot-form');
	const submit = form?.querySelector<HTMLButtonElement>('[data-async-button]') ?? null;

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		clearFieldErrors(form);
		const email = String(new FormData(form).get('email') ?? '').trim();
		if (!email || !isValidEmail(email)) {
			setFieldError(form, 'email', !email ? 'Masukkan email kamu.' : 'Gunakan format email yang valid.');
			window.toast.error('Periksa kembali email yang ditandai.');
			focusFirstInvalid(form);
			return;
		}

		setButtonLoading(submit, true);
		try {
			const response = await api.auth.forgotPassword(email);
			window.toast.success(response.message);
		} catch (error) {
			window.toast.error(error instanceof ApiError ? error.message : 'Permintaan belum berhasil. Coba lagi.');
		} finally {
			setButtonLoading(submit, false);
		}
	});
</script>
