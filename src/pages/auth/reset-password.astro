---
import AuthField from '../../components/auth/AuthField.astro';
import AuthShell from '../../components/auth/AuthShell.astro';
import PasswordStrengthBar from '../../components/auth/PasswordStrengthBar.astro';
import ActionButton from '../../components/ui/ActionButton.astro';
---

<AuthShell title="Reset password" heading="Pilih password baru." intro="Gunakan password panjang yang mudah kamu ingat dan tidak dipakai di layanan lain.">
	<form class="auth-form" id="reset-form" novalidate>
		<div>
			<AuthField id="reset-password" name="password" label="Password baru" hint="(15 sampai 72 karakter)" type="password" autocomplete="new-password" icon="lock" placeholder="Minimal 15 karakter" minlength={15} maxlength={72} required />
			<PasswordStrengthBar id="reset-password" />
		</div>
		<AuthField id="reset-password-confirmation" name="password_confirmation" label="Ulangi password" type="password" autocomplete="new-password" icon="lock" placeholder="Ulangi password di atas" minlength={15} maxlength={72} required />
		<ActionButton label="Simpan password baru" loadingLabel="Menyimpan password..." icon="save" type="submit" />
	</form>
</AuthShell>

<script>
	import { ApiError, api } from '../../lib/api';
	import { clearFieldErrors, focusFirstInvalid, setButtonLoading, setFieldError, validateStrongPassword, type AuthFieldErrors } from '../../lib/auth-form';

	const params = new URLSearchParams(window.location.search);
	const token = params.get('token') ?? '';
	const email = params.get('email') ?? '';
	const form = document.querySelector<HTMLFormElement>('#reset-form');
	const submit = form?.querySelector<HTMLButtonElement>('[data-async-button]') ?? null;

	if (!token || !email) {
		window.toast.error('Tautan reset tidak lengkap. Minta tautan baru.', { duration: 0 });
		if (submit) submit.disabled = true;
	}

	const validate = (data: FormData): AuthFieldErrors => {
		const errors: AuthFieldErrors = {};
		const password = String(data.get('password') ?? '');
		const confirmation = String(data.get('password_confirmation') ?? '');
		const passwordError = validateStrongPassword(password);
		if (passwordError) errors.password = passwordError;
		if (confirmation !== password) errors.password_confirmation = 'Ulangi password harus sama.';
		return errors;
	};

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!token || !email) return;
		clearFieldErrors(form);
		const data = new FormData(form);
		const clientErrors = validate(data);
		if (Object.keys(clientErrors).length) {
			Object.entries(clientErrors).forEach(([field, message]) => setFieldError(form, field, message));
			window.toast.error('Periksa kembali password yang ditandai.');
			focusFirstInvalid(form);
			return;
		}

		setButtonLoading(submit, true);
		try {
			const response = await api.auth.resetPassword({
				token,
				email,
				password: String(data.get('password') ?? ''),
				password_confirmation: String(data.get('password_confirmation') ?? ''),
			});
			window.toast.success(response.message);
			setTimeout(() => window.location.assign('/auth/login'), 1000);
		} catch (error) {
			if (error instanceof ApiError && error.errors) {
				Object.entries(error.errors).forEach(([field, messages]) => setFieldError(form, field, messages[0] ?? ''));
			}
			window.toast.error(error instanceof ApiError ? error.message : 'Password belum dapat diubah. Coba lagi.');
			setButtonLoading(submit, false);
		}
	});
</script>
