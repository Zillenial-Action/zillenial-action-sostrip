---
interface Props {
	count?: number;
}
const { count = 3 } = Astro.props;
---

{Array.from({ length: count }).map(() => (
	<div class="flex items-center gap-sm rounded-xl border border-outline-variant bg-surface p-sm" aria-hidden="true">
		<div class="skeleton h-4 w-4 rounded-full shrink-0"></div>
		<div class="skeleton h-4 w-full max-w-[180px] rounded-md"></div>
	</div>
))}

<style>
	.skeleton {
		background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
		background-size: 200% 100%;
		animation: shimmer 1.4s infinite;
	}

	@keyframes shimmer {
		0% { background-position: 200% 0; }
		100% { background-position: -200% 0; }
	}
</style>
