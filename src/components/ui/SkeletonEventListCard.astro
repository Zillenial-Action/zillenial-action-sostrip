---
interface Props {
	count?: number;
}
const { count = 3 } = Astro.props;
---

{Array.from({ length: count }).map(() => (
	<div class="flex gap-sm rounded-2xl border border-outline-variant/40 bg-white p-sm shadow-[0_6px_18px_-14px_rgba(80,67,78,0.35)]" aria-hidden="true">
		<div class="relative aspect-[4/5] w-[104px] shrink-0 overflow-hidden rounded-xl skeleton"></div>
		<div class="min-w-0 flex-1 py-1 space-y-2">
			<div class="flex items-center gap-xs">
				<div class="skeleton h-4 w-16 rounded-full"></div>
				<div class="skeleton h-4 w-12 rounded-full"></div>
			</div>
			<div class="skeleton h-5 w-3/4 rounded-lg"></div>
			<div class="space-y-1 mt-2">
				<div class="skeleton h-3 w-1/2 rounded-md"></div>
				<div class="skeleton h-3 w-2/5 rounded-md"></div>
			</div>
		</div>
	</div>
))}

<style>
	.skeleton {
		background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
		background-size: 200% 100%;
		animation: shimmer 1.4s infinite;
	}

	@keyframes shimmer {
		0% { background-position: 200% 0; }
		100% { background-position: -200% 0; }
	}
</style>
