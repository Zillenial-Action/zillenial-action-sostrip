---
interface Props {
	count?: number;
}
const { count = 4 } = Astro.props;
---

{Array.from({ length: count }).map(() => (
	<div
		class="min-w-[280px] w-[280px] bg-white rounded-2xl shadow-[0_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30 overflow-hidden shrink-0 snap-start"
		aria-hidden="true"
	>
		<div class="skeleton aspect-[16/10] w-full"></div>
		<div class="p-4 space-y-3">
			<div class="skeleton h-5 w-3/4 rounded-lg"></div>
			<div class="space-y-2">
				<div class="skeleton h-3 w-1/2 rounded-md"></div>
				<div class="skeleton h-3 w-2/5 rounded-md"></div>
			</div>
		</div>
	</div>
))}

<style>
	.skeleton {
		background: linear-gradient(90deg, rgba(255,255,255,0.15) 25%, rgba(255,255,255,0.3) 50%, rgba(255,255,255,0.15) 75%);
		background-size: 200% 100%;
		animation: shimmer 1.4s infinite;
	}

	@keyframes shimmer {
		0% { background-position: 200% 0; }
		100% { background-position: -200% 0; }
	}
</style>
