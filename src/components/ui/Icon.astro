---
type IconName =
	| 'alert'
	| 'arrow-left'
	| 'calendar'
	| 'check'
	| 'email'
	| 'eye'
	| 'eye-off'
	| 'google'
	| 'lock'
	| 'login'
	| 'logout'
	| 'payment'
	| 'register'
	| 'save'
	| 'send'
	| 'spinner'
	| 'ticket'
	| 'user';

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class:list={['ui-icon', `ui-icon--${name}`, className]} viewBox="0 0 24 24" aria-hidden="true">
	{name === 'alert' && <><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5.5M12 16.5h.01" /></>}
	{name === 'arrow-left' && <path d="m14.5 6-6 6 6 6" />}
	{name === 'calendar' && <><rect x="3.5" y="5" width="17" height="15" rx="2" /><path d="M7.5 3v4M16.5 3v4M3.5 9h17" /></>}
	{name === 'check' && <><circle cx="12" cy="12" r="9" /><path d="m8 12 2.7 2.7L16.5 9" /></>}
	{name === 'email' && <><path d="M4 6.5h16v11H4z" /><path d="m4.5 7 7.5 6 7.5-6" /></>}
	{name === 'eye' && <><path d="M2.5 12s3.5-5 9.5-5 9.5 5 9.5 5-3.5 5-9.5 5-9.5-5-9.5-5Z" /><circle cx="12" cy="12" r="2.5" /></>}
	{name === 'eye-off' && <><path d="M3 3l18 18" /><path d="M10.6 7.1A10.8 10.8 0 0 1 12 7c6 0 9.5 5 9.5 5a16 16 0 0 1-2.2 2.6M14.2 14.3A3 3 0 0 1 9.7 9.8M6.2 6.3C3.8 7.8 2.5 12 2.5 12s3.5 5 9.5 5c1.2 0 2.3-.2 3.2-.5" /></>}
	{name === 'google' && <><path fill="#4285F4" d="M21.6 12.23c0-.71-.06-1.4-.19-2.07H12v3.91h5.38a4.6 4.6 0 0 1-2 3.02v2.54h3.24c1.9-1.75 2.98-4.33 2.98-7.4Z" /><path fill="#34A853" d="M12 22c2.7 0 4.97-.9 6.62-2.37l-3.24-2.54c-.9.6-2.05.96-3.38.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.62A10 10 0 0 0 12 22Z" /><path fill="#FBBC05" d="M6.39 13.92A6 6 0 0 1 6.08 12c0-.67.11-1.32.31-1.92V7.46H3.04A10 10 0 0 0 2 12c0 1.61.39 3.14 1.04 4.54l3.35-2.62Z" /><path fill="#EA4335" d="M12 5.95c1.47 0 2.79.51 3.83 1.5l2.87-2.88A9.64 9.64 0 0 0 12 2a10 10 0 0 0-8.96 5.46l3.35 2.62C7.18 7.71 9.39 5.95 12 5.95Z" /></>}
	{name === 'lock' && <><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8.5 10V7.5a3.5 3.5 0 0 1 7 0V10" /></>}
	{name === 'login' && <><path d="M14 8l4 4-4 4M18 12H7" /><path d="M10 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4" /></>}
	{name === 'logout' && <><path d="m10 8-4 4 4 4M6 12h11" /><path d="M14 5h4a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-4" /></>}
	{name === 'payment' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 9h18M7 15h3" /></>}
	{name === 'register' && <><circle cx="9" cy="8" r="3" /><path d="M3.5 19a5.5 5.5 0 0 1 11 0M18 9v6M15 12h6" /></>}
	{name === 'save' && <><path d="M5 4h12l2 2v14H5z" /><path d="M8 4v6h8V4M8 20v-6h8v6" /></>}
	{name === 'send' && <><path d="m3 11 18-8-8 18-2-8-8-2Z" /><path d="m11 13 5-5" /></>}
	{name === 'spinner' && <circle cx="12" cy="12" r="9" />}
	{name === 'ticket' && <><path d="M4 7a2 2 0 0 0 2-2h12v4a3 3 0 0 0 0 6v4H6a2 2 0 0 0-2-2Z" /><path d="M12 7v2M12 11v2M12 15v2" /></>}
	{name === 'user' && <><circle cx="12" cy="8" r="3.5" /><path d="M5 20a7 7 0 0 1 14 0" /></>}
</svg>

<style>
	.ui-icon { display: block; width: 20px; height: 20px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
	.ui-icon--google { stroke: none; }
	.ui-icon--spinner { animation: ui-icon-spin .75s linear infinite; stroke-width: 2.5; stroke-dasharray: 42 18; }
	@keyframes ui-icon-spin { to { transform: rotate(360deg); } }
	@media (prefers-reduced-motion: reduce) { .ui-icon--spinner { animation: none; } }
</style>
