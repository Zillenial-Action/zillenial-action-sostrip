---
interface Props {
	id: string;
}

const { id } = Astro.props;

const rules = [
	{ key: 'length', label: 'Minimal 15 karakter' },
	{ key: 'mixedCase', label: 'Huruf besar dan huruf kecil' },
	{ key: 'number', label: 'Mengandung angka' },
	{ key: 'symbol', label: 'Mengandung simbol, misalnya ! # $ % &' },
];
---

<div class="mt-1.5" data-password-strength={id}>
	<ul class="grid gap-1">
		{rules.map((rule) => (
			<li class="flex items-center gap-1.5 text-xs text-on-surface-variant transition-colors" data-strength-rule={rule.key}>
				<span class="grid h-4 w-4 shrink-0 place-items-center rounded-full border border-outline text-[10px] font-black leading-none text-transparent transition-colors" data-rule-icon>✓</span>
				{rule.label}
			</li>
		))}
	</ul>

	<div class="mt-2 flex gap-1" role="presentation" data-strength-bar hidden>
		<span class="h-1.5 flex-1 rounded-full bg-outline-variant/50 transition-colors" data-strength-segment></span>
		<span class="h-1.5 flex-1 rounded-full bg-outline-variant/50 transition-colors" data-strength-segment></span>
		<span class="h-1.5 flex-1 rounded-full bg-outline-variant/50 transition-colors" data-strength-segment></span>
		<span class="h-1.5 flex-1 rounded-full bg-outline-variant/50 transition-colors" data-strength-segment></span>
	</div>
	<p class="mt-1 text-xs font-semibold" data-strength-label aria-live="polite"></p>
</div>

<script>
	import { evaluatePasswordStrength, getPasswordRuleStatus } from '../../lib/auth-form';

	const SCORE_COLORS = ['#ba1a1a', '#ba1a1a', '#b45309', '#a16207', '#15803d'];
	const RULE_MET_COLOR = '#15803d';

	const bindStrengthBar = () => {
		document.querySelectorAll<HTMLElement>('[data-password-strength]:not([data-strength-ready])').forEach((wrap) => {
			wrap.dataset.strengthReady = 'true';
			const targetId = wrap.dataset.passwordStrength;
			const input = targetId ? document.getElementById(targetId) : null;
			if (!(input instanceof HTMLInputElement)) return;

			const ruleItems = Array.from(wrap.querySelectorAll<HTMLElement>('[data-strength-rule]'));
			const bar = wrap.querySelector<HTMLElement>('[data-strength-bar]');
			const segments = Array.from(wrap.querySelectorAll<HTMLElement>('[data-strength-segment]'));
			const label = wrap.querySelector<HTMLElement>('[data-strength-label]');

			const render = () => {
				const value = input.value;
				const status = getPasswordRuleStatus(value);

				ruleItems.forEach((item) => {
					const key = item.dataset.strengthRule as keyof typeof status | undefined;
					const met = key ? status[key] : false;
					const icon = item.querySelector<HTMLElement>('[data-rule-icon]');
					item.style.color = met ? '#1c1b1b' : '';
					if (icon) {
						icon.style.background = met ? RULE_MET_COLOR : '';
						icon.style.borderColor = met ? RULE_MET_COLOR : '';
						icon.style.color = met ? '#fff' : '';
					}
				});

				if (bar) bar.hidden = value.length === 0;
				if (!value) return;

				const strength = evaluatePasswordStrength(value);
				const color = SCORE_COLORS[strength.score];
				segments.forEach((segment, index) => {
					segment.style.background = index < strength.score ? color : '';
				});
				if (label) {
					label.textContent = `Kekuatan password: ${strength.label}`;
					label.style.color = color;
				}
			};

			input.addEventListener('input', render);
			render();
		});
	};

	bindStrengthBar();
	document.addEventListener('astro:page-load', bindStrengthBar);
</script>
