---
import Icon from '../ui/Icon.astro';

interface Props {
	id: string;
	kind: 'error' | 'success';
	hidden?: boolean;
}

const { id, kind, hidden = true } = Astro.props;
const styles = kind === 'error' ? 'bg-error-container text-on-error-container' : 'bg-[#dcfce7] text-[#14532d]';
---

<div class:list={['auth-notice flex items-start gap-sm rounded-xl px-md py-sm text-sm font-semibold', styles]} {id} {hidden} role={kind === 'error' ? 'alert' : 'status'}>
	<Icon name={kind === 'error' ? 'alert' : 'check'} class="mt-0.5 shrink-0" />
	<span data-notice-message></span>
</div>

<style>
	.auth-notice[hidden] { display: none; }
</style>
