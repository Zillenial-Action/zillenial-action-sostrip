---
import Icon from '../ui/Icon.astro';

interface Props {
	roundedBottom?: boolean;
}

const { roundedBottom = true } = Astro.props;
---

<header class:list={['relative bg-primary px-gutter py-sm animate-reveal', roundedBottom && 'rounded-b-[32px]']}>
	<div class="flex items-center justify-between gap-sm">
		<a
			class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/35 bg-white/20 text-white backdrop-blur-md transition-transform active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
			href="/"
			aria-label="Kembali ke beranda"
		>
			<Icon name="arrow-left" />
		</a>
		<slot name="action">
			<a href="/" class="flex h-9 items-center" aria-label="Zillenial Action">
				<img src="/Logo_ZA_putih.png" alt="Zillenial Action" class="h-full w-auto object-contain drop-shadow-sm" />
			</a>
		</slot>
	</div>
</header>
