---
import Layout from '../../layouts/Layout.astro';
import AuthPageHeader from './AuthPageHeader.astro';

interface Props {
	title: string;
	heading: string;
	intro: string;
	showFootnote?: boolean;
}

const { title, heading, intro, showFootnote = true } = Astro.props;
---

<Layout title={`${title} | Zillenial Action`}>
	<main class="pb-16">
		<AuthPageHeader roundedBottom={false} />

		<section class="relative overflow-hidden rounded-b-[32px] bg-primary px-gutter pb-8 pt-1 text-on-primary animate-reveal delay-100">
			<div
				class="pointer-events-none absolute inset-0 opacity-25"
				style="background-image: radial-gradient(circle at 100% 0%, rgba(255,255,255,0.35) 0%, transparent 55%), radial-gradient(circle at 0% 100%, rgba(255,255,255,0.16) 0%, transparent 55%);"
			></div>
			<div class="relative z-10">
				<p class="inline-flex rounded-full bg-white/20 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.08em] text-white backdrop-blur-md">Akun Sostrip</p>
				<h1 id="auth-heading" data-auth-heading class="mt-sm font-headline-lg-mobile text-[clamp(28px,7vw,38px)] leading-[1.06] text-white" style="overflow-wrap: anywhere;">{heading}</h1>
				<p class="mt-sm text-body-sm text-white/85" data-auth-intro>{intro}</p>
			</div>
		</section>

		<section class="relative -mt-4 px-gutter" aria-labelledby="auth-heading">
			<div class="rounded-2xl border border-outline-variant/40 bg-white p-md shadow-[0_10px_28px_-16px_rgba(80,67,78,0.4)] animate-reveal delay-200">
				<slot />
			</div>
		</section>

		{showFootnote && <p class="mt-md px-gutter text-center text-body-sm text-on-surface-variant">Guest checkout tetap tersedia. Akun membantu kamu menemukan transaksi di satu tempat.</p>}
	</main>
</Layout>

<style>
	:global(.auth-form) { display: grid; gap: 16px; }
	:global(.auth-row) { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
	:global(.auth-check) { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; color: #50434e; font: 400 13px/18px Inter, sans-serif; }
	:global(.auth-check input) { width: 18px; height: 18px; accent-color: #7d297f; }
	:global(.auth-check input:focus-visible), :global(.auth-link:focus-visible) { outline: 3px solid #7d297f; outline-offset: 3px; }
	:global(.auth-link) { color: #752177; font: 700 13px/18px Inter, sans-serif; text-decoration: underline; text-underline-offset: 3px; }
	:global(.auth-divider) { display: flex; align-items: center; gap: 12px; color: #50434e; font: 400 12px/18px Inter, sans-serif; }
	:global(.auth-divider::before), :global(.auth-divider::after) { content: ''; height: 1px; flex: 1; background: #d4c1cf; }
	:global(.auth-muted) { color: #50434e; font: 400 13px/20px Inter, sans-serif; }
	:global(.auth-center) { text-align: center; }
</style>
